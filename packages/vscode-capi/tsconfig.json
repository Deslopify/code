{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "esnext",
		"target": "esnext",
		"types": [],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": false,
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"emitDeclarationOnly": true
	},
	"include": ["./src"]
}
